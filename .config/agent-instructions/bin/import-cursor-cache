#!/usr/bin/env python3
"""Extract titled Cursor User Rules from the newest local prompt snapshot."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import sqlite3
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_DATABASE = (
    Path.home()
    / "Library/Application Support/Cursor/User/globalStorage/state.vscdb"
)
EXPECTED_TITLES = (
    "Agent thread naming",
    "Browser tests",
    "Commit messages",
    "DDEV",
    "Formatting",
    "Git",
    "Jira",
    "Karpathy behavioral guidelines",
    "Responses",
    "Shell agents",
    "Socket",
    "User context",
)
USER_RULE_RE = re.compile(r"<user_rule>(.*?)</user_rule>", re.DOTALL)
TITLE_RE = re.compile(r"^# ([^\n]+)\n", re.MULTILINE)
DATE_RE = re.compile(r"Today's date: (\w+ \w+ \d{1,2}, \d{4})")
REQUESTABLE_RE = re.compile(
    r'<agent_requestable_workspace_rule fullPath="([^"]+)">(.*?)'
    r"</agent_requestable_workspace_rule>",
    re.DOTALL,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database", type=Path, default=DEFAULT_DATABASE)
    parser.add_argument("--date", default=dt.date.today().isoformat())
    return parser.parse_args()


def decode_blob(value: bytes | str) -> str:
    raw = value.decode("utf-8") if isinstance(value, bytes) else value
    record = json.loads(raw)
    content = record.get("content")
    if not isinstance(content, str):
        raise ValueError("Cursor prompt blob does not contain string content")
    return content


def titled_rules(content: str) -> list[dict[str, str]]:
    rules = []
    for match in USER_RULE_RE.finditer(content):
        body = match.group(1).strip()
        title_match = TITLE_RE.match(body)
        if title_match:
            rules.append({"title": title_match.group(1).strip(), "content": body + "\n"})
    return rules


def prompt_date(content: str) -> dt.date | None:
    match = DATE_RE.search(content)
    if not match:
        return None
    return dt.datetime.strptime(match.group(1), "%A %b %d, %Y").date()


def signature(rules: list[dict[str, str]]) -> str:
    encoded = json.dumps(rules, ensure_ascii=False, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def main() -> int:
    args = parse_args()
    database = args.database.expanduser().resolve()
    if not database.is_file():
        raise SystemExit(f"Cursor database not found: {database}")

    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        rows = connection.execute(
            """
            SELECT key, value
            FROM cursorDiskKV
            WHERE key LIKE 'agentKv:blob:%'
              AND instr(CAST(value AS TEXT), '# Agent thread naming') > 0
            """
        ).fetchall()
    finally:
        connection.close()

    candidates = []
    expected = set(EXPECTED_TITLES)
    for key, value in rows:
        content = decode_blob(value)
        rules = titled_rules(content)
        by_title = {rule["title"]: rule for rule in rules}
        if expected.issubset(by_title):
            selected = rules
            candidates.append(
                {
                    "key": key,
                    "date": prompt_date(content),
                    "rules": selected,
                    "signature": signature(selected),
                    "requestable": [
                        {"path": path, "description": description.strip()}
                        for path, description in REQUESTABLE_RE.findall(content)
                    ],
                }
            )

    if not candidates:
        raise SystemExit("No local Cursor prompt contains all expected titled User Rules")

    dated = [candidate for candidate in candidates if candidate["date"] is not None]
    if not dated:
        raise SystemExit("Matching Cursor prompts have no parseable prompt date")
    newest_date = max(candidate["date"] for candidate in dated)
    newest = [candidate for candidate in dated if candidate["date"] == newest_date]
    signatures = {candidate["signature"] for candidate in newest}
    if len(signatures) != 1:
        raise SystemExit(
            f"Newest cache date {newest_date} has conflicting User Rule snapshots"
        )
    selected = sorted(newest, key=lambda item: item["key"])[0]

    destination = ROOT / "imports" / "cursor" / args.date / "user-rules-cache.json"
    destination.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "schema_version": 1,
        "extracted_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "source_database": str(database),
        "source_record_key": selected["key"],
        "source_prompt_date": selected["date"].isoformat(),
        "content_sha256": selected["signature"],
        "cache_limitations": [
            "Prompt snapshots are secondary cache evidence, not the live cloud rule store.",
            "Cloud rule ids are not present.",
            "The cache may remain stale until a new Cursor agent prompt loads current rules.",
        ],
        "expected_titles_present": list(EXPECTED_TITLES),
        "rules": selected["rules"],
        "observed_requestable_workspace_rules": selected["requestable"],
    }
    destination.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    print(f"wrote {len(selected['rules'])} User Rules: {destination}")
    print(
        f"newest cached prompt: {selected['date']} "
        f"({len(newest)} equivalent snapshot(s))"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
