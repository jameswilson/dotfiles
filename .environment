#!/usr/bin/env sh
# CLI environment variables configuration for bash and zsh
# to be used instead of .bash_environment or .zshenv
# echo ~/.environment

# Default Editor
export EDITOR="vim"

# Language, locale, and character encoding.
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Homebrew
if [ -x /opt/homebrew/bin/brew ]; then
  export HOMEBREW_PREFIX=/opt/homebrew
else
  export HOMEBREW_PREFIX=/usr/local
fi
export HOMEBREW_HOME="$HOMEBREW_PREFIX/Cellar"
pathmunge "$HOMEBREW_PREFIX/bin"
pathmunge "$HOMEBREW_PREFIX/sbin"

# Python
pathmunge "$HOMEBREW_PREFIX/opt/python/bin"
pathmunge "$HOMEBREW_PREFIX/opt/python/libexec/bin"

# Ruby config for running Jekyll locally
# Following https://jekyllrb.com/docs/installation/macos/
# See also ~/.local/bin/brew.sh
source "$HOMEBREW_PREFIX/opt/chruby/share/chruby/chruby.sh"
source "$HOMEBREW_PREFIX/opt/chruby/share/chruby/auto.sh"
chruby ruby-3.4.1

# Replace some macOs utils with GNU utils.
# Note: this requires `brew install coreutils findutils`.
# @see brew.sh
pathmunge "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"
pathmunge "$HOMEBREW_PREFIX/opt/findutils/libexec/gnubin"

# Custom scripts.
pathmunge $HOME/.local/bin

# PHP Composer.
pathmunge $COMPOSER_HOME/vendor/bin
export COMPOSER_MEMORY_LIMIT=-1

# Platform.sh CLI
pathmunge $HOME/.platformsh/bin

# Node JS
export NODE_PATH="/usr/local/lib/node"
export NPM_HOME="/usr/local/lib/node_modules/npm"
export NVM_DIR="$HOME/.nvm"

# Go Lang
export GOPATH=$HOME/.go
export GOROOT="$HOMEBREW_PREFIX/opt/go/libexec"
pathmunge $GOPATH/bin

# Obsidian CLI
pathmunge /Applications/Obsidian.app/Contents/MacOS

if [ -f $HOME/.env ]; then
  source $HOME/.env
fi
